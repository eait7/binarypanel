{
	admin 0.0.0.0:2019
}

# ── BinaryPanel Admin (HTTPS, zero-config) ───────────────────────────────
# Serves BinaryPanel on port 8443 with a self-signed certificate.
# The cert is generated by the install script with the server's IP SANs.
# Access at https://YOUR-SERVER-IP:8443 (accept the browser's cert warning)
# For a proper SSL cert: set PANEL_DOMAIN=panel.yourdomain.com in .env
#
:8443 {
	tls /etc/caddy/panel.crt /etc/caddy/panel.key
	reverse_proxy dashboard:9000
}

# ── HTTP default ─────────────────────────────────────────────────────────
:80 {
	respond "BinaryPanel is running. Access your panel securely at https://{host}:8443"
}
