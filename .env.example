# ============================================================
# BinaryPanel Configuration — EXAMPLE FILE
# ============================================================
# WARNING: ALL values below are INSECURE DEFAULTS.
# You MUST change them before deploying to a public IP.
#
# Generate a strong secret with:  openssl rand -hex 32
# ============================================================

# HMAC secret used to sign session tokens. MUST be 32+ random characters.
BINARYPANEL_SECRET=change-this-to-a-secure-random-string-in-production

# Fallback login credentials (used only if no bcrypt password is set via UI).
# CHANGE THESE immediately. Prefer using Settings > Authentication in the dashboard.
BINARYPANEL_USERNAME=admin
BINARYPANEL_PASSWORD=admin

# Set to true when serving BinaryPanel over HTTPS (enables Secure cookie flag).
BINARYPANEL_HTTPS=false
